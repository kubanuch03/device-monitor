# Учётка входа в панель создаётся при ПЕРВОМ запуске (дальше живёт в базе и
# меняется в интерфейсе, «Аккаунт»). Пароль можно задать здесь; если оставить
# пустым, сервис сгенерирует случайный и положит его в data/first-login.txt.
#
#   cp .env.example .env && docker compose up -d
# DM_DEFAULT_USERNAME=admin
# DM_DEFAULT_PASSWORD=

# UID/GID владельца каталога data — если он не 1000 (посмотреть: id -u, id -g).
# DM_UID=1000
# DM_GID=1000
